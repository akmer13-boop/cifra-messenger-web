# Amvera frontend staging build
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_CIFRA_API_URL=https://cifragateway-staging-ilyaman.amvera.io

# These values are supplied by the staging environment, but the Web client
# intentionally does not connect to them directly. It requests a short-lived
# realtime ticket from the Gateway and validates the WSS endpoint returned by
# that ticket, so credentials never travel in a WebSocket URL.
NEXT_PUBLIC_CIFRA_WS_URL=wss://cifragateway-staging-ilyaman.amvera.io/api/v1/realtime
NEXT_PUBLIC_TINODE_WS_URL=wss://cifragateway-staging-ilyaman.amvera.io/api/v1/tinode
